@model Zubac.Models.MakeOrderViewModel

@{
    ViewData["Title"] = "Free drink";
    ViewData["Mode"] = "free";
    ViewData["FormAction"] = "FreeDrink";
    ViewData["SubmitText"] = "Log free order";
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">On the house</div>
            <h1 class="page-title reveal" style="--i:1">Free drink</h1>
            <p class="page-sub reveal" style="--i:2">Log complimentary items. They count towards statistics but not revenue.</p>
        </div>
    </header>

    <partial name="_OrderBuilder" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <script>Zubac.orderBuilder(document.getElementById('orderForm'));</script>
}
