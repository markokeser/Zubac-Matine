@model List<Zubac.Models.Order>

@{
    ViewData["Title"] = "Active orders";
    Func<Zubac.Models.Order, decimal> calculateTotal = o => o.OrderArticles.Sum(x => x.Article.Price * x.Quantity);
    var totalOfAllOrders = Model.Sum(order => calculateTotal(order));
    var totalItems = Model.Sum(o => o.OrderArticles.Sum(a => a.Quantity));
    var index = 0;
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">Table service</div>
            <h1 class="page-title reveal" style="--i:1">Active orders</h1>
            <p class="page-sub reveal" style="--i:2">Your open tables, newest first. Finish an order once the table has paid.</p>
        </div>
        <div class="page-head__actions reveal" style="--i:2">
            <a asp-action="Create" class="button button--primary">@Html.Icon("plus") New order</a>
        </div>
    </header>

    @if (!Model.Any())
    {
        <div class="card reveal" style="--i:3">
            <div class="empty">
                <div class="empty__icon">@Html.Icon("inbox")</div>
                <div class="empty__title">No open tables</div>
                <p class="empty__text">You don't have any active orders right now. New orders will show up here until you finish them.</p>
                <a asp-action="Create" class="button button--primary">@Html.Icon("plus") Start an order</a>
            </div>
        </div>
    }
    else
    {
        <div class="stats">
            <div class="stat stat--hero reveal" style="--i:3">
                <div class="stat__label">@Html.Icon("euro") Open value</div>
                <div class="stat__value">@UiHelpers.Money(totalOfAllOrders)</div>
                <div class="stat__sub">Across all your active tables</div>
            </div>
            <div class="stat reveal" style="--i:4">
                <div class="stat__label">@Html.Icon("hash") Open tables</div>
                <div class="stat__value">@Model.Count</div>
                <div class="stat__sub">@totalItems items served</div>
            </div>
        </div>

        <div class="orders-grid">
            @foreach (var order in Model)
            {
                var orderTotal = calculateTotal(order);
                var itemCount = order.OrderArticles.Sum(a => a.Quantity);
                var preview = string.Join(", ", order.OrderArticles.Select(a => $"{a.Quantity}× {a.Article.Name}"));

                <article class="card order-card reveal" style="--i:@(Math.Min(++index + 4, 14))">
                    <div class="order-card__head">
                        <div class="table-badge">
                            <small>Table</small>
                            <strong>@order.TableNumber</strong>
                        </div>
                        <div style="min-width: 0;">
                            <div class="order-card__title">Table @order.TableNumber</div>
                            <div class="order-card__meta">
                                <span title="@order.Created.ToString("dd.MM.yyyy HH:mm")">@Html.Icon("clock") @order.Created.ToString("HH:mm")</span>
                                <span>· @UiHelpers.TimeAgo(order.Created)</span>
                            </div>
                        </div>
                        <div class="order-card__total">
                            <div class="order-card__amount">@UiHelpers.Money(orderTotal)</div>
                            <div class="order-card__count">@itemCount @(itemCount == 1 ? "item" : "items")</div>
                        </div>
                    </div>

                    <details class="disclosure">
                        <summary>
                            @Html.Icon("clipboard")
                            <span class="disclosure__preview">@preview</span>
                            @Html.Icon("chevron-down")
                        </summary>
                        <ul class="lines">
                            @foreach (var item in order.OrderArticles)
                            {
                                <li>
                                    <span class="lines__qty">@item.Quantity×</span>
                                    <span class="lines__name">@item.Article.Name</span>
                                    <span class="lines__price">@UiHelpers.Money(item.Article.Price * item.Quantity)</span>
                                </li>
                            }
                        </ul>
                    </details>

                    <form asp-action="Finish" method="post"
                          data-confirm="Mark the order for table @order.TableNumber (@UiHelpers.Money(orderTotal)) as paid and close it?"
                          data-confirm-title="Finish this order?"
                          data-confirm-ok="Finish order"
                          data-confirm-icon="check-circle">
                        <input type="hidden" name="id" value="@order.Id" />
                        <button type="submit" class="button button--success button--block">
                            @Html.Icon("check") <span>Finish order</span>
                        </button>
                    </form>
                </article>
            }
        </div>
    }
</div>
