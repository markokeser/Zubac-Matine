@model Zubac.Models.MakeOrderViewModel

@{
    ViewData["Title"] = "New order";
    ViewData["Mode"] = "table";
    ViewData["FormAction"] = "Create";
    ViewData["SubmitText"] = "Send order";
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">Table service</div>
            <h1 class="page-title reveal" style="--i:1">New order</h1>
            <p class="page-sub reveal" style="--i:2">Choose a table, tap items to add them, then send the order.</p>
        </div>
        <div class="page-head__actions reveal" style="--i:2">
            <a asp-action="Index" class="button button--outline-gold">@Html.Icon("receipt") Active orders</a>
        </div>
    </header>

    <partial name="_OrderBuilder" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <script>Zubac.orderBuilder(document.getElementById('orderForm'));</script>
}
