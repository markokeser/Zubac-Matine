@model Zubac.Models.MakeOrderViewModel

@{
    ViewData["Title"] = "Bar order";
    ViewData["Mode"] = "bar";
    ViewData["FormAction"] = "OrderOnBar";
    ViewData["SubmitText"] = "Complete bar order";
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">Bar</div>
            <h1 class="page-title reveal" style="--i:1">Bar order</h1>
            <p class="page-sub reveal" style="--i:2">For drinks served and paid at the bar — the order is completed right away.</p>
        </div>
    </header>

    <partial name="_OrderBuilder" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <script>Zubac.orderBuilder(document.getElementById('orderForm'));</script>
}
