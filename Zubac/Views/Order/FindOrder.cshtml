@model Zubac.Models.FindOrderViewModel

@{
    ViewData["Title"] = "Find order";
    var searched = Context.Request.Method == "POST";
    var waiterNames = Model.Waiters.ToDictionary(w => w.Id, w => w.Username);
    var orders = Model.Orders ?? new List<Zubac.Models.Order>();
    decimal OrderTotal(Zubac.Models.Order o) => o.OrderArticles.Sum(a => a.Article.Price * a.Quantity);
    var grandTotal = orders.Where(o => !o.IsFree).Sum(OrderTotal);
    var index = 0;
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">History</div>
            <h1 class="page-title reveal" style="--i:1">Find order</h1>
            <p class="page-sub reveal" style="--i:2">Look up past and open orders by table, staff member, or both.</p>
        </div>
    </header>

    <form asp-action="FindOrder" method="post" class="card reveal" style="--i:3; margin-bottom: 24px;" data-loading>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <div class="field">
                    <label asp-for="TableNumber" class="label">@Html.Icon("hash") Table</label>
                    <select asp-for="TableNumber" class="select">
                        <option value="">Any table</option>
                        <option value="0">Bar (no table)</option>
                        @for (int i = 1; i <= 20; i++)
                        {
                            <option value="@i">Table @i</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div class="field">
                    <label asp-for="CreatedBy" class="label">@Html.Icon("user") Staff member</label>
                    <select asp-for="CreatedBy" class="select">
                        <option value="">Anyone</option>
                        @foreach (var w in Model.Waiters.OrderBy(w => w.Username))
                        {
                            <option value="@w.Id">@w.Username · @UiHelpers.RankName(w.UserRank)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="button button--primary button--lg button--block">
                    @Html.Icon("search") <span>Search</span>
                </button>
            </div>
        </div>
    </form>

    @if (orders.Count > 0)
    {
        <div class="row-gap" style="margin-bottom: 14px; justify-content: space-between;">
            <h2 class="section-title" style="margin: 0;">@orders.Count @(orders.Count == 1 ? "result" : "results")</h2>
            <span class="muted" style="font-size: .88rem;">Paid total <strong class="num gold">@UiHelpers.Money(grandTotal)</strong></span>
        </div>

        <div class="orders-grid">
            @foreach (var order in orders)
            {
                var total = OrderTotal(order);
                var itemCount = order.OrderArticles.Sum(a => a.Quantity);
                var waiter = waiterNames.TryGetValue(order.CreatedBy, out var name) ? name : $"User #{order.CreatedBy}";
                var isBar = order.OnBar || order.TableNumber == 0;

                <article class="card order-card reveal" style="--i:@(Math.Min(++index + 3, 14))">
                    <div class="order-card__head">
                        <div class="table-badge @(isBar ? "table-badge--bar" : "")">
                            <small>@(isBar ? "Bar" : "Table")</small>
                            @if (isBar)
                            {
                                @Html.Icon("martini", "icon--lg")
                            }
                            else
                            {
                                <strong>@order.TableNumber</strong>
                            }
                        </div>
                        <div style="min-width: 0;">
                            <div class="order-card__title">Order <span class="num">#@order.Id</span></div>
                            <div class="order-card__meta">
                                <span>@Html.Icon("user") @waiter</span>
                                <span>@Html.Icon("calendar") @order.Created.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)</span>
                            </div>
                        </div>
                        <div class="order-card__total">
                            <div class="order-card__amount">@UiHelpers.Money(total)</div>
                            <div class="order-card__count">@itemCount @(itemCount == 1 ? "item" : "items")</div>
                        </div>
                    </div>

                    <div class="row-gap">
                        @if (order.Finished)
                        {
                            <span class="tag tag--dot" data-tone="success">Finished</span>
                        }
                        else
                        {
                            <span class="tag tag--dot" data-tone="gold">Open</span>
                        }
                        @if (order.OnBar)
                        {
                            <span class="tag" data-tone="violet">@Html.Icon("martini") Bar</span>
                        }
                        @if (order.IsFree)
                        {
                            <span class="tag" data-tone="rose">@Html.Icon("gift") On the house</span>
                        }
                    </div>

                    <details class="disclosure">
                        <summary>
                            @Html.Icon("clipboard")
                            <span class="disclosure__preview">@string.Join(", ", order.OrderArticles.Select(a => $"{a.Quantity}× {a.Article.Name}"))</span>
                            @Html.Icon("chevron-down")
                        </summary>
                        <ul class="lines">
                            @foreach (var item in order.OrderArticles)
                            {
                                <li>
                                    <span class="lines__qty">@item.Quantity×</span>
                                    <span class="lines__name">@item.Article.Name</span>
                                    <span class="lines__price">@UiHelpers.Money(item.Article.Price * item.Quantity)</span>
                                </li>
                            }
                        </ul>
                    </details>
                </article>
            }
        </div>
    }
    else if (searched)
    {
        <div class="card reveal" style="--i:4">
            <div class="empty">
                <div class="empty__icon">@Html.Icon("search")</div>
                <div class="empty__title">No orders found</div>
                <p class="empty__text">Nothing matches those filters. Try another table or staff member.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card reveal" style="--i:4">
            <div class="empty">
                <div class="empty__icon">@Html.Icon("clipboard")</div>
                <div class="empty__title">Search the order history</div>
                <p class="empty__text">Choose a table and/or a staff member above, then hit search. Leave both empty to see everything.</p>
            </div>
        </div>
    }
</div>
