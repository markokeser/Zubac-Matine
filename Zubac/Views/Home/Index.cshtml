@{
    ViewData["Title"] = "Dashboard";

    var userRank = User.FindFirst("UserRank")?.Value;
    var userName = User.FindFirst(ClaimTypes.Name)?.Value;
    var restaurantName = User.FindFirst("RestaurantName")?.Value;
    bool freeDrinksEnabled = User.HasClaim("FreeDrinksEnabled", "True");
    bool foodEnabled = User.HasClaim("FoodEnabled", "True");

    bool canServeTables = userRank == "1" || userRank == "2" || userRank == "3";
    bool canServeBar = userRank == "0" || userRank == "2" || userRank == "3";
    bool isManager = userRank == "2" || userRank == "3";
    bool isAdmin = userRank == "3";

    var index = 0;
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <div class="eyebrow reveal">@(string.IsNullOrWhiteSpace(restaurantName) ? "Dashboard" : restaurantName)</div>
            <h1 class="page-title reveal" style="--i:1"><span data-greeting>Welcome back</span>, <em>@userName</em></h1>
            <p class="page-sub reveal" style="--i:2">What would you like to do?</p>
        </div>
        <div class="page-head__actions reveal" style="--i:2">
            <span class="tag tag--dot" data-tone="@(foodEnabled ? "success" : "muted")">Food @(foodEnabled ? "on" : "off")</span>
            <span class="tag tag--dot" data-tone="@(freeDrinksEnabled ? "success" : "muted")">Free drinks @(freeDrinksEnabled ? "on" : "off")</span>
        </div>
    </header>

    @if (canServeTables || canServeBar || freeDrinksEnabled)
    {
        <h2 class="section-title reveal" style="--i:2">Service</h2>
        <div class="tiles" style="margin-bottom: 36px;">
            @if (canServeTables)
            {
                <a asp-controller="Order" asp-action="Create" class="tile tile--feature reveal" style="--i:@(++index + 2)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg">@Html.Icon("plus")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">New order</div>
                        <div class="tile__desc">Pick a table and send an order</div>
                    </div>
                </a>

                <a asp-controller="Order" asp-action="Index" class="tile reveal" style="--i:@(++index + 2)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg" data-tone="info">@Html.Icon("receipt")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Active orders</div>
                        <div class="tile__desc">Review open tables and close them</div>
                    </div>
                </a>
            }

            @if (canServeBar)
            {
                <a asp-controller="Order" asp-action="OrderOnBar" class="tile reveal" style="--i:@(++index + 2)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg" data-tone="violet">@Html.Icon("martini")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Bar order</div>
                        <div class="tile__desc">Ring up drinks served at the bar</div>
                    </div>
                </a>
            }

            @if (freeDrinksEnabled)
            {
                <a asp-controller="Order" asp-action="FreeDrink" class="tile reveal" style="--i:@(++index + 2)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg" data-tone="rose">@Html.Icon("gift")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Free drink</div>
                        <div class="tile__desc">Log a drink on the house</div>
                    </div>
                </a>
            }
        </div>
    }

    @if (isManager)
    {
        <h2 class="section-title reveal" style="--i:@(index + 3)">Management</h2>
        <div class="tiles">
            @if (isAdmin)
            {
                <a asp-controller="Statistics" asp-action="Index" class="tile reveal" style="--i:@(++index + 3)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg" data-tone="success">@Html.Icon("chart")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Statistics</div>
                        <div class="tile__desc">Revenue, best sellers and staff performance</div>
                    </div>
                </a>

                <a asp-controller="Order" asp-action="FindOrder" class="tile reveal" style="--i:@(++index + 3)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg" data-tone="teal">@Html.Icon("search")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Find order</div>
                        <div class="tile__desc">Search the order history by table or staff</div>
                    </div>
                </a>
            }

            <a asp-controller="AiSommelier" asp-action="Index" class="tile reveal" style="--i:@(++index + 3)">
                <div class="tile__top">
                    <span class="chip-icon chip-icon--lg" data-tone="amber">@Html.Icon("wine")</span>
                    <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                </div>
                <div class="tile__body">
                    <div class="tile__title">AI Sommelier</div>
                    <div class="tile__desc">Guest-facing drink pairing assistant</div>
                </div>
            </a>

            @if (isAdmin)
            {
                <a asp-controller="Settings" asp-action="Index" class="tile reveal" style="--i:@(++index + 3)">
                    <div class="tile__top">
                        <span class="chip-icon chip-icon--lg">@Html.Icon("settings")</span>
                        <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                    </div>
                    <div class="tile__body">
                        <div class="tile__title">Settings</div>
                        <div class="tile__desc">Staff, menu and restaurant configuration</div>
                    </div>
                </a>
            }
        </div>
    }
</div>
