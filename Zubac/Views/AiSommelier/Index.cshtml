@model Zubac.Models.AiSommelierViewModel

@{
    ViewData["Title"] = "AI Sommelier";
    ViewData["HideChrome"] = true;
    var restaurantName = User.FindFirst("RestaurantName")?.Value;
}

@Html.AntiForgeryToken()

<div class="sommelier">
    <header class="sommelier__head">
        @if (!string.IsNullOrWhiteSpace(restaurantName))
        {
            <div class="sommelier__venue reveal">@restaurantName</div>
        }
        <h1 class="sommelier__title reveal" style="--i:1">AI <em>Sommelier</em></h1>
        <p class="sommelier__sub reveal" style="--i:2">Savršeno piće uz svako jelo</p>
    </header>

    @if (!Model.FoodArticles.Any())
    {
        <div class="card reveal" style="--i:3">
            <div class="empty">
                <div class="empty__icon">@Html.Icon("wine")</div>
                <div class="empty__title">Sommelier se priprema</div>
                <p class="empty__text">Trenutno nema jela za preporuku. Osoblje može da ih uključi u podešavanjima menija (AI pairing).</p>
            </div>
        </div>
    }
    else
    {
        <form id="sommelierForm" class="card card--glow reveal" style="--i:3">
            <div class="card__head">
                <div class="card__title">
                    <span class="chip-icon">@Html.Icon("utensils")</span>
                    <div>
                        Izaberite glavno jelo
                        <div class="card__desc">Naš AI sommelier će predložiti piće koje ga najbolje prati.</div>
                    </div>
                </div>
            </div>

            <div class="dish-grid" role="radiogroup" aria-label="Jelo">
                @foreach (var article in Model.FoodArticles)
                {
                    <label class="dish">
                        <input type="radio" name="foodId" value="@article.Id" data-name="@article.Name" />
                        <span>@Html.Icon("utensils") @article.Name</span>
                    </label>
                }
            </div>

            <button type="submit" class="button button--primary button--lg button--block" id="recommendBtn" style="margin-top: 22px;" disabled>
                @Html.Icon("wine") <span>Preporuči piće</span>
            </button>
        </form>

        <section class="pairing" id="pairing" aria-live="polite">
            <span class="pairing__glass">@Html.Icon("wine")</span>
            <div class="pairing__label">Preporuka sommeliera</div>
            <div class="pairing__drink" id="pairingDrink"></div>
            <div class="pairing__with" id="pairingWith"></div>
            <p class="pairing__text" id="pairingText"></p>
        </section>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('sommelierForm');
            if (!form) return;

            const btn = document.getElementById('recommendBtn');
            const pairing = document.getElementById('pairing');

            form.addEventListener('change', () => {
                btn.disabled = !form.querySelector('input[name="foodId"]:checked');
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const selected = form.querySelector('input[name="foodId"]:checked');
                if (!selected) return;

                Zubac.setLoading(btn);
                pairing.classList.remove('is-visible');

                try {
                    const res = await fetch('@Url.Action("GetRecommendation", "AiSommelier")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: new URLSearchParams({ foodId: selected.value })
                    });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const data = await res.json();

                    if (data.success) {
                        document.getElementById('pairingDrink').textContent = data.drinkName || 'Naš izbor';
                        document.getElementById('pairingWith').textContent = `uz ${selected.dataset.name}`;
                        document.getElementById('pairingText').textContent = data.message;
                        pairing.classList.add('is-visible');
                        pairing.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        Zubac.toast('Sommelier trenutno nema preporuku za ovo jelo.', 'info');
                    }
                } catch (err) {
                    Zubac.toast('Sommelier trenutno nije dostupan. Pokušajte ponovo.', 'error');
                } finally {
                    Zubac.clearLoading(btn);
                }
            });
        })();
    </script>
}
