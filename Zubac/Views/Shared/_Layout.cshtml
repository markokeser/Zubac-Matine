@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var hideChrome = ViewData["HideChrome"] is bool hide && hide;
    var showChrome = isAuthenticated && !hideChrome;

    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var restaurantName = User.FindFirst("RestaurantName")?.Value;
    var rankValue = int.TryParse(User.FindFirst("UserRank")?.Value, out var parsedRank) ? parsedRank : -1;

    var toastMessage = TempData["Toast"] as string;
    var toastType = TempData["ToastType"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#090b14" />
    <title>@(ViewData["Title"] is string title && title.Length > 0 ? $"{title} · Zubac" : "Zubac")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <partial name="_Icons" />
    <div class="app-bg" aria-hidden="true"></div>

    @if (showChrome)
    {
        <header class="topbar">
            <div class="topbar__inner">
                <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Dashboard">
                    <span class="brand__mark">Z</span>
                    <span class="brand__text">
                        <span class="brand__name">@(string.IsNullOrWhiteSpace(restaurantName) ? "Zubac" : restaurantName)</span>
                        <span class="brand__sub">Zubac · Service</span>
                    </span>
                </a>

                <div class="topbar__actions">
                    <div class="user-chip" title="@userName · @UiHelpers.RankName(rankValue)">
                        <span class="avatar" data-tone="@UiHelpers.RankTone(rankValue)">@UiHelpers.Initials(userName)</span>
                        <span class="user-chip__meta">
                            <span class="user-chip__name">@userName</span>
                            <span class="user-chip__role">@UiHelpers.RankName(rankValue)</span>
                        </span>
                    </div>
                    <a class="button button--ghost button--icon" asp-controller="Account" asp-action="Logout"
                       aria-label="Sign out" title="Sign out"
                       data-confirm="You'll need your password to sign back in."
                       data-confirm-title="Sign out?"
                       data-confirm-ok="Sign out"
                       data-confirm-icon="logout">
                        @Html.Icon("logout")
                    </a>
                </div>
            </div>
        </header>
    }

    <main id="main" class="app-main">
        @RenderBody()
    </main>

    <div class="toasts" id="toasts" aria-live="polite"></div>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title">
                        <span class="chip-icon">@Html.Icon("check-circle")</span>
                        <div>
                            <div id="confirmModalTitle" data-confirm-title>Are you sure?</div>
                            <div class="modal-sub" data-confirm-message></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="button button--ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="button button--primary" data-confirm-ok>Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <script>Zubac.toast(@Json.Serialize(toastMessage), @Json.Serialize(toastType));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
