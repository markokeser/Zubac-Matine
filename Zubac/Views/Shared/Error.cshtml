@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page page--narrow">
    <div class="card reveal" style="margin-top: clamp(20px, 8vh, 80px);">
        <div class="empty">
            <div class="empty__icon" style="color: var(--danger); background: rgba(242,114,114,.08); border-color: rgba(242,114,114,.25);">@Html.Icon("alert")</div>
            <div class="empty__title">Something went wrong</div>
            <p class="empty__text">We couldn't finish that request. Please try again — if it keeps happening, let your administrator know.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="faint" style="margin-top: 14px; font-size: .8rem;">Reference: <code class="num" style="color: var(--text-2);">@Model.RequestId</code></p>
            }
            <div class="row-gap" style="justify-content: center; margin-top: 20px;">
                <button type="button" class="button button--ghost" onclick="history.back()" style="margin-top: 0;">@Html.Icon("chevron-left") Go back</button>
                <a asp-controller="Home" asp-action="Index" class="button button--primary" style="margin-top: 0;">@Html.Icon("home") Dashboard</a>
            </div>
        </div>
    </div>
</div>
