@model StatisticsViewModel
@{
    ViewData["Title"] = "Statistics";

    var paidUsers = (Model.PaidUserStats ?? new()).OrderByDescending(u => u.Earnings).ToList();
    var freeUsers = (Model.FreeUserStats ?? new()).Where(u => u.FreeOrdersCount > 0).OrderByDescending(u => u.FreeOrdersCount).ToList();
    var paidArticles = Model.PaidArticles ?? new();
    var freeArticles = Model.FreeArticles ?? new();

    var maxEarning = paidUsers.Select(u => u.Earnings).DefaultIfEmpty(0).Max();
    var maxFree = freeUsers.Select(u => u.FreeOrdersCount).DefaultIfEmpty(0).Max();
    var maxSold = paidArticles.Select(a => a.Quantity).DefaultIfEmpty(0).Max();
    var maxFreeArticle = freeArticles.Select(a => a.Quantity).DefaultIfEmpty(0).Max();

    var totalFreeItems = freeArticles.Sum(a => a.Quantity);
    var topSeller = paidArticles.FirstOrDefault();
    var averageItemPrice = Model.TotalPaidDrinks > 0 ? Model.TotalPaidEarnings / Model.TotalPaidDrinks : 0;
    var hasPaidUsers = paidUsers.Any(u => u.Earnings > 0);

    string Pct(decimal value, decimal max) =>
        (max <= 0 ? 0 : Math.Max(2, Math.Round(value / max * 100, 1))).ToString(CultureInfo.InvariantCulture) + "%";

    var periodStart = Model.PeriodStart?.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture);
    var periodEnd = Model.IsRealtime ? "now" : Model.PeriodEnd?.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture);
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">Insights</div>
            <h1 class="page-title reveal" style="--i:1">Statistics</h1>
            @if (periodStart != null)
            {
                <div class="period-chip reveal" style="--i:2; margin-top: 14px;">
                    @if (Model.IsRealtime)
                    {
                        <span class="live-dot" aria-hidden="true"></span>
                    }
                    else
                    {
                        @Html.Icon("calendar")
                    }
                    <span>@periodStart → @periodEnd</span>
                </div>
            }
        </div>
        <div class="page-head__actions no-print reveal" style="--i:2">
            <a asp-controller="Settings" asp-action="RestaurantSettings" class="button button--ghost">@Html.Icon("sliders") Change period</a>
            <button type="button" class="button button--outline-gold" onclick="window.print()">@Html.Icon("printer") Print report</button>
        </div>
    </header>

    <div class="stats">
        <div class="stat stat--hero reveal" style="--i:3">
            <div class="stat__label">@Html.Icon("euro") Revenue</div>
            <div class="stat__value">@UiHelpers.Money(Model.TotalEarnings)</div>
            <div class="stat__sub">Paid orders in this period</div>
        </div>
        <div class="stat reveal" style="--i:4">
            <div class="stat__label">@Html.Icon("receipt") Items sold</div>
            <div class="stat__value">@Model.TotalPaidDrinks</div>
            <div class="stat__sub">Avg. @UiHelpers.Money(averageItemPrice) per item</div>
        </div>
        <div class="stat reveal" style="--i:5">
            <div class="stat__label">@Html.Icon("gift") Free orders</div>
            <div class="stat__value">@Model.TotalFreeOrders</div>
            <div class="stat__sub">@totalFreeItems items on the house</div>
        </div>
        <div class="stat reveal" style="--i:6">
            <div class="stat__label">@Html.Icon("trending") Top seller</div>
            @if (topSeller != null)
            {
                <div class="stat__value truncate" style="font-size: clamp(1.25rem, 2.2vw, 1.5rem); margin-top: 16px;" title="@topSeller.Name">@topSeller.Name</div>
                <div class="stat__sub">@topSeller.Quantity sold · @UiHelpers.Money(topSeller.Earnings)</div>
            }
            else
            {
                <div class="stat__value faint">—</div>
                <div class="stat__sub">No sales yet</div>
            }
        </div>
    </div>

    <div class="grid-2" style="margin-bottom: 20px;">
        <section class="card reveal" style="--i:7">
            <div class="card__head">
                <h2 class="card__title">
                    <span class="chip-icon chip-icon--sm">@Html.Icon("users")</span>
                    Revenue by staff
                </h2>
            </div>
            @if (hasPaidUsers)
            {
                <ul class="bars">
                    @for (var i = 0; i < paidUsers.Count; i++)
                    {
                        var u = paidUsers[i];
                        <li class="bar-row" title="@u.Username: @UiHelpers.Money(u.Earnings)">
                            <span class="bar-row__label">
                                <span class="avatar" data-tone="@UiHelpers.RankTone(u.UserRank)" style="width: 26px; height: 26px; font-size: .62rem;">@UiHelpers.Initials(u.Username)</span>
                                <span>@u.Username</span>
                                <span class="faint" style="font-size: .78rem; font-weight: 400;">@UiHelpers.RankName(u.UserRank)</span>
                            </span>
                            <span class="bar-row__value">@UiHelpers.Money(u.Earnings)</span>
                            <span class="bar-row__track"><span class="bar-row__fill" style="--w:@Pct(u.Earnings, maxEarning); --i:@i"></span></span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty empty--sm">
                    <div class="empty__icon">@Html.Icon("inbox")</div>
                    <div class="empty__title">No paid orders yet</div>
                    <p class="empty__text">Revenue per team member will appear here.</p>
                </div>
            }
        </section>

        <section class="card reveal" style="--i:8">
            <div class="card__head">
                <h2 class="card__title">
                    <span class="chip-icon chip-icon--sm" data-tone="violet">@Html.Icon("gift")</span>
                    Free orders by staff
                </h2>
            </div>
            @if (freeUsers.Any())
            {
                <ul class="bars">
                    @for (var i = 0; i < freeUsers.Count; i++)
                    {
                        var u = freeUsers[i];
                        <li class="bar-row" title="@u.Username: @u.FreeOrdersCount free orders">
                            <span class="bar-row__label">
                                <span class="avatar" data-tone="violet" style="width: 26px; height: 26px; font-size: .62rem;">@UiHelpers.Initials(u.Username)</span>
                                <span>@u.Username</span>
                            </span>
                            <span class="bar-row__value">@u.FreeOrdersCount</span>
                            <span class="bar-row__track"><span class="bar-row__fill bar-row__fill--violet" style="--w:@Pct(u.FreeOrdersCount, maxFree); --i:@i"></span></span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty empty--sm">
                    <div class="empty__icon">@Html.Icon("gift")</div>
                    <div class="empty__title">Nothing on the house</div>
                    <p class="empty__text">No complimentary orders in this period.</p>
                </div>
            }
        </section>
    </div>

    <section class="card card--flush sellers reveal" style="--i:9; margin-bottom: 20px;">
        <div class="card__head">
            <h2 class="card__title">
                <span class="chip-icon chip-icon--sm" data-tone="success">@Html.Icon("trending")</span>
                Best sellers
            </h2>
            <span class="muted" style="font-size: .84rem;">Paid items, by quantity</span>
        </div>

        @if (paidArticles.Any())
        {
            <div class="list-head">
                <span>Item</span>
                <span>Share of sales</span>
                <span style="text-align: right;">Sold</span>
                <span style="text-align: right;">Revenue</span>
            </div>
            @for (var i = 0; i < paidArticles.Count; i++)
            {
                var a = paidArticles[i];
                <div class="list-row">
                    <div class="bar-row__label">
                        <span class="rank-num @(i < 3 ? $"rank-num--{i + 1}" : "")">@(i + 1)</span>
                        <span>@a.Name</span>
                    </div>
                    <div class="c-bar">
                        <div class="bar-row__track" title="@a.Name: @a.Quantity sold"><span class="bar-row__fill" style="--w:@Pct(a.Quantity, maxSold); --i:@Math.Min(i, 10)"></span></div>
                    </div>
                    <div class="c-qty num" style="text-align: right; font-weight: 600;">@a.Quantity</div>
                    <div class="item-price" style="text-align: right;">@UiHelpers.Money(a.Earnings)</div>
                </div>
            }
            <div class="list-row" style="background: rgba(0,0,0,.15);">
                <div style="font-weight: 600;">Total</div>
                <div class="c-bar"></div>
                <div class="c-qty num" style="text-align: right; font-weight: 700;">@Model.TotalPaidDrinks</div>
                <div class="item-price" style="text-align: right;">@UiHelpers.Money(Model.TotalPaidEarnings)</div>
            </div>
        }
        else
        {
            <div class="empty empty--sm">
                <div class="empty__icon">@Html.Icon("chart")</div>
                <div class="empty__title">No sales yet</div>
                <p class="empty__text">Your best sellers will be ranked here as orders come in.</p>
            </div>
        }
    </section>

    <section class="card reveal" style="--i:10">
        <div class="card__head">
            <h2 class="card__title">
                <span class="chip-icon chip-icon--sm" data-tone="rose">@Html.Icon("gift")</span>
                Given on the house
            </h2>
            <span class="muted" style="font-size: .84rem;">@totalFreeItems items total</span>
        </div>
        @if (freeArticles.Any())
        {
            <ul class="bars">
                @for (var i = 0; i < freeArticles.Count; i++)
                {
                    var a = freeArticles[i];
                    <li class="bar-row" title="@a.Name: @a.Quantity free">
                        <span class="bar-row__label"><span>@a.Name</span></span>
                        <span class="bar-row__value">@a.Quantity</span>
                        <span class="bar-row__track"><span class="bar-row__fill bar-row__fill--violet" style="--w:@Pct(a.Quantity, maxFreeArticle); --i:@Math.Min(i, 10)"></span></span>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty empty--sm">
                <div class="empty__icon">@Html.Icon("gift")</div>
                <div class="empty__title">No free items</div>
                <p class="empty__text">Complimentary drinks will be listed here.</p>
            </div>
        }
    </section>
</div>
