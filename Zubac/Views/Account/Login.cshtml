@model Zubac.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    ViewData["HideChrome"] = true;
}

<div class="auth">
    <aside class="auth__showcase">
        <div class="brand">
            <span class="brand__mark">Z</span>
            <span class="brand__text">
                <span class="brand__name">Zubac</span>
                <span class="brand__sub">Restaurant OS</span>
            </span>
        </div>

        <div>
            <div class="eyebrow reveal">Front of house, simplified</div>
            <h1 class="auth__headline reveal" style="--i:1">Run every table <em>beautifully.</em></h1>
            <p class="auth__lead reveal" style="--i:2">Orders, bar tabs, menus and nightly numbers — in one calm, fast workspace built for busy service.</p>

            <div class="auth__features">
                <div class="auth__feature reveal" style="--i:3">
                    <span class="chip-icon">@Html.Icon("receipt")</span>
                    <span>Tap-to-add ordering for tables and the bar</span>
                </div>
                <div class="auth__feature reveal" style="--i:4">
                    <span class="chip-icon" data-tone="violet">@Html.Icon("sparkles")</span>
                    <span>AI menu import and an AI sommelier for guests</span>
                </div>
                <div class="auth__feature reveal" style="--i:5">
                    <span class="chip-icon" data-tone="success">@Html.Icon("trending")</span>
                    <span>Live revenue and best-seller statistics</span>
                </div>
            </div>
        </div>

        <p class="auth__foot">© @DateTime.Now.Year Zubac</p>
    </aside>

    <section class="auth__panel">
        <div class="auth-card reveal">
            <div class="brand auth-card__brand">
                <span class="brand__mark">Z</span>
                <span class="brand__text">
                    <span class="brand__name">Zubac</span>
                    <span class="brand__sub">Restaurant OS</span>
                </span>
            </div>

            <h2 class="auth-card__title">Welcome back</h2>
            <p class="auth-card__sub">Sign in with your staff account to start service.</p>

            <form asp-action="Login" method="post" class="auth-card__form" id="loginForm" data-loading>
                <div asp-validation-summary="ModelOnly"></div>

                <div class="field">
                    <label asp-for="Username" class="label"></label>
                    <div class="input-wrap">
                        @Html.Icon("user")
                        <input asp-for="Username" class="input" placeholder="e.g. marko" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    </div>
                    <span asp-validation-for="Username"></span>
                </div>

                <div class="field">
                    <label asp-for="Password" class="label"></label>
                    <div class="input-wrap input-wrap--action">
                        @Html.Icon("lock")
                        <input asp-for="Password" class="input" placeholder="Your password" autocomplete="current-password" />
                        <button type="button" class="input-wrap__action" data-toggle-password aria-label="Show password">@Html.Icon("eye")</button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="button button--primary button--lg button--block" style="margin-top: 8px;">
                    <span>Sign in</span>
                    @Html.Icon("arrow-right")
                </button>
            </form>

            <div class="divider">or</div>

            <button type="button" class="demo-card" id="demoLogin">
                <span class="chip-icon">@Html.Icon("sparkles")</span>
                <span>
                    <span class="demo-card__title d-block">Explore the demo</span>
                    <span class="demo-card__desc d-block">Jump in with a sample restaurant — no account needed.</span>
                </span>
                @Html.Icon("arrow-right")
            </button>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('demoLogin').addEventListener('click', function () {
            const form = document.getElementById('loginForm');
            form.querySelector('input[name="Username"]').value = 'demo_user';
            form.querySelector('input[name="Password"]').value = 'demo_pass';
            this.disabled = true;
            Zubac.setLoading(form.querySelector('[type="submit"]'));
            form.submit();
        });
    </script>
}
