@model List<Zubac.Models.AiMenuItemViewModel>

@{
    ViewData["Title"] = "AI menu builder";
    var hasResults = Model != null && Model.Any();
    var analysed = Model != null;
}

@Html.AntiForgeryToken()

<div class="page page--mid">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Settings" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Settings</a>
            <div class="eyebrow reveal">Powered by AI</div>
            <h1 class="page-title reveal" style="--i:1">AI menu <em>builder</em></h1>
            <p class="page-sub reveal" style="--i:2">Upload a photo of a printed menu. We'll read every item and price — you review, then save it to your menu.</p>
        </div>
    </header>

    <div class="steps reveal" style="--i:3" aria-label="Progress">
        <span class="step @(hasResults ? "is-done" : "is-active")"><span class="step__num">@if (hasResults) { @Html.Icon("check") } else { <text>1</text> }</span> Upload</span>
        <span class="step__line"></span>
        <span class="step @(hasResults ? "is-active" : "")"><span class="step__num">2</span> Review</span>
        <span class="step__line"></span>
        <span class="step"><span class="step__num">3</span> Save</span>
    </div>

    <div asp-validation-summary="All"></div>

    @if (!hasResults)
    {
        @if (analysed)
        {
            <div class="notice notice--gold reveal" style="--i:4; margin-bottom: 20px;">
                @Html.Icon("info")
                <span><strong>No menu items found.</strong> Try a sharper, well-lit photo where the text fills most of the frame.</span>
            </div>
        }

        <form asp-action="UploadMenuImage" asp-controller="Settings" method="post" enctype="multipart/form-data" class="card reveal" style="--i:4" id="uploadForm">
            <label class="dropzone" id="dropzone">
                <input type="file" name="image" accept="image/*" required id="menuImage" aria-label="Menu photo" />
                <div class="dropzone__placeholder">
                    <span class="chip-icon chip-icon--lg" style="margin: 0 auto 14px;">@Html.Icon("upload")</span>
                    <div class="dropzone__title">Drop a menu photo here</div>
                    <div class="dropzone__hint">or click to browse · JPG, PNG or HEIC from your phone</div>
                </div>
                <img class="dropzone__preview" id="menuPreview" alt="Selected menu photo" />
            </label>

            <div class="row-gap" style="margin-top: 18px; justify-content: space-between;">
                <span class="muted" id="fileName" style="font-size: .88rem;">No file selected</span>
                <button type="submit" class="button button--primary button--lg" id="uploadBtn" disabled>
                    @Html.Icon("sparkles") <span>Read menu with AI</span>
                </button>
            </div>
        </form>

        <div class="grid-2" style="margin-top: 20px;">
            <div class="notice reveal" style="--i:5">
                @Html.Icon("image")
                <span><strong>Best results:</strong> shoot straight on, avoid glare, one page per photo.</span>
            </div>
            <div class="notice reveal" style="--i:6">
                @Html.Icon("shield")
                <span><strong>Nothing is saved yet.</strong> You'll review every item before it's added.</span>
            </div>
        </div>
    }
    else
    {
        <form asp-action="ConfirmAiMenu" asp-controller="Settings" method="post" id="confirmAiForm">
            <div class="card card--flush ai-list reveal" style="--i:4">
                <div class="list-toolbar">
                    <div class="card__title">
                        <span class="chip-icon chip-icon--sm" data-tone="success">@Html.Icon("check-circle")</span>
                        <span><span id="activeCount">@Model!.Count</span> of @Model.Count items selected</span>
                    </div>
                    <div class="row-gap">
                        <button type="button" class="link-button" data-select="all">Select all</button>
                        <button type="button" class="link-button" data-select="none">Select none</button>
                    </div>
                </div>

                <div class="list-head">
                    <span></span>
                    <span>Name</span>
                    <span>Price (€)</span>
                    <span>Kind</span>
                    <span>Type</span>
                </div>

                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <div class="list-row" data-row>
                        <div class="c-check">
                            <label class="check" title="Include this item">
                                <input type="checkbox" checked data-include aria-label="Include @item.Name" />
                                <span>@Html.Icon("check")</span>
                            </label>
                        </div>
                        <div class="c-name">
                            <input type="text" name="Items[@i].Name" value="@item.Name" class="input input--sm" required aria-label="Name" />
                        </div>
                        <div class="c-price">
                            <input type="number" step="0.01" min="0" inputmode="decimal" name="Items[@i].Price" value="@UiHelpers.Invariant(item.Price)" class="input input--sm num" required aria-label="Price" />
                        </div>
                        <div class="c-kind">
                            <div class="segmented" role="radiogroup" aria-label="Kind">
                                <input type="radio" id="kind-@(i)-d" name="Items[@i].IsFood" value="false" data-kind @(item.IsFood ? "" : "checked") />
                                <label for="kind-@(i)-d">@Html.Icon("wine") Drink</label>
                                <input type="radio" id="kind-@(i)-f" name="Items[@i].IsFood" value="true" data-kind @(item.IsFood ? "checked" : "") />
                                <label for="kind-@(i)-f">@Html.Icon("utensils") Food</label>
                            </div>
                        </div>
                        <div class="c-type">
                            <select name="Items[@i].Type" class="select input--sm" data-type-select data-current="@item.Type" aria-label="Type"></select>
                        </div>
                    </div>
                }
            </div>

            <div class="row-gap reveal" style="--i:5; margin-top: 20px; justify-content: space-between;">
                <a asp-action="AiMenuBuilder" class="button button--ghost">@Html.Icon("rotate") Start over</a>
                <button type="submit" class="button button--primary button--lg" id="confirmBtn">
                    @Html.Icon("save") <span>Save <span id="saveCount">@Model.Count</span> items to menu</span>
                </button>
            </div>
        </form>
    }
</div>

<div class="processing" id="processing" role="status" aria-live="assertive">
    <div class="orb">@Html.Icon("sparkles")</div>
    <div class="processing__title">Reading your menu…</div>
    <p class="processing__text">The AI is detecting dishes, drinks and prices. This usually takes 10–30 seconds.</p>
</div>

@section Scripts {
    <script>
        (function () {
            /* Step 1 — upload */
            const uploadForm = document.getElementById('uploadForm');
            if (uploadForm) {
                const input = document.getElementById('menuImage');
                const zone = document.getElementById('dropzone');
                const preview = document.getElementById('menuPreview');
                const fileName = document.getElementById('fileName');
                const uploadBtn = document.getElementById('uploadBtn');

                const showFile = () => {
                    const file = input.files && input.files[0];
                    uploadBtn.disabled = !file;
                    zone.classList.toggle('has-file', !!file);
                    fileName.textContent = file ? `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} MB` : 'No file selected';
                    if (file && file.type.startsWith('image/')) {
                        preview.src = URL.createObjectURL(file);
                    }
                };

                input.addEventListener('change', showFile);
                ['dragenter', 'dragover'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.add('is-dragover')));
                ['dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.remove('is-dragover')));

                uploadForm.addEventListener('submit', () => {
                    document.getElementById('processing').classList.add('is-visible');
                    Zubac.setLoading(uploadBtn);
                });
                window.addEventListener('pageshow', () => document.getElementById('processing').classList.remove('is-visible'));
            }

            /* Step 2 — review */
            const confirmForm = document.getElementById('confirmAiForm');
            if (!confirmForm) return;

            const foodTypes = ['Soup', 'Salad', 'Meat', 'Fish', 'Dessert', 'Other'];
            const drinkTypes = ['Cocktail', 'Red Wine', 'White Wine', 'Rose Wine', 'Beer', 'Spirit', 'NonAlcoholic', 'Other'];
            const labels = { 'NonAlcoholic': 'Non-alcoholic', 'Rose Wine': 'Rosé Wine' };
            const normalize = (s) => (s || '').toLowerCase().replace(/[^a-z]/g, '');
            const rows = Array.from(confirmForm.querySelectorAll('[data-row]'));

            function fillTypes(row) {
                const select = row.querySelector('[data-type-select]');
                const isFood = row.querySelector('[data-kind]:checked').value === 'true';
                const list = isFood ? foodTypes : drinkTypes;
                const wanted = normalize(select.value || select.dataset.current);
                const match = list.find((t) => normalize(t) === wanted) || 'Other';

                select.innerHTML = '';
                list.forEach((t) => select.add(new Option(labels[t] || t, t, false, t === match)));
            }

            function refresh() {
                const active = rows.filter((r) => r.querySelector('[data-include]').checked).length;
                document.getElementById('activeCount').textContent = active;
                document.getElementById('saveCount').textContent = active;
                document.getElementById('confirmBtn').disabled = active === 0;
            }

            rows.forEach((row) => {
                fillTypes(row);
                row.querySelectorAll('[data-kind]').forEach((r) => r.addEventListener('change', () => fillTypes(row)));
                row.querySelector('[data-include]').addEventListener('change', (e) => {
                    row.classList.toggle('is-removed', !e.target.checked);
                    row.querySelectorAll('input:not([data-include]), select').forEach((el) => el.disabled = !e.target.checked);
                    refresh();
                });
            });

            confirmForm.querySelectorAll('[data-select]').forEach((btn) => btn.addEventListener('click', () => {
                const on = btn.dataset.select === 'all';
                rows.forEach((row) => {
                    const cb = row.querySelector('[data-include]');
                    if (cb.checked !== on) { cb.checked = on; cb.dispatchEvent(new Event('change')); }
                });
            }));

            confirmForm.addEventListener('submit', (e) => {
                const included = rows.filter((r) => r.querySelector('[data-include]').checked);
                const invalid = included.find((r) => !r.querySelector('[name$=".Name"]').value.trim() || r.querySelector('[name$=".Price"]').value === '');
                if (included.length === 0 || invalid) {
                    e.preventDefault();
                    Zubac.toast(included.length === 0 ? 'Select at least one item to save.' : 'Every selected item needs a name and a price.', 'error');
                    if (invalid) invalid.querySelector('input:invalid, input').focus();
                    return;
                }

                // Excluded rows are disabled (not posted); re-index the rest so model binding sees a contiguous list.
                included.forEach((row, i) => {
                    row.querySelectorAll('[name^="Items["]').forEach((el) => {
                        el.name = el.name.replace(/^Items\[\d+\]/, `Items[${i}]`);
                    });
                });
                Zubac.setLoading(document.getElementById('confirmBtn'));
            });

            refresh();
        })();
    </script>
}
