@model Zubac.Models.RestaurantSettingsViewModel

@{
    ViewData["Title"] = "Restaurant settings";
}

<div class="page page--narrow">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Settings" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Settings</a>
            <div class="eyebrow reveal">Configuration</div>
            <h1 class="page-title reveal" style="--i:1">Restaurant</h1>
            <p class="page-sub reveal" style="--i:2">Define the service day used for statistics and switch features on or off for your staff.</p>
        </div>
    </header>

    <form asp-action="SaveSettings" method="post" id="settingsForm" class="stack" data-loading>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AdminId" />

        <div asp-validation-summary="All" style="margin-bottom: 0;"></div>

        <section class="card reveal" style="--i:3">
            <div class="card__head">
                <div class="card__title">
                    <span class="chip-icon">@Html.Icon("calendar")</span>
                    <div>
                        Service day
                        <div class="card__desc">Statistics count orders placed inside this window.</div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <div class="field">
                        <label asp-for="StartTime" class="label">Starts</label>
                        <input asp-for="StartTime" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="input" />
                        <span class="hint">Changing it requires all open orders to be finished.</span>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="field">
                        <label asp-for="EndTime" class="label">Ends</label>
                        <input asp-for="EndTime" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="input" id="endTimeInput" />
                        <span class="hint" id="endTimeHint">Ignored while live counting is on.</span>
                    </div>
                </div>
            </div>

            <label class="toggle-row" style="margin-top: 18px;">
                <span class="chip-icon chip-icon--sm" data-tone="success">@Html.Icon("zap")</span>
                <span class="toggle-row__text">
                    <span class="toggle-row__title d-block">Live counting</span>
                    <span class="toggle-row__desc d-block">Keep counting up to the current moment instead of stopping at an end time.</span>
                </span>
                <span class="switch switch--success">
                    <input asp-for="RealtimeCounting" type="checkbox" id="realtimeCheckbox" />
                    <span class="switch__track"></span>
                </span>
            </label>
        </section>

        <section class="card reveal" style="--i:4">
            <div class="card__head">
                <div class="card__title">
                    <span class="chip-icon" data-tone="violet">@Html.Icon("shield")</span>
                    <div>
                        Features
                        <div class="card__desc">Control what your staff can do during service.</div>
                    </div>
                </div>
            </div>

            <label class="toggle-row">
                <span class="chip-icon chip-icon--sm" data-tone="amber">@Html.Icon("utensils")</span>
                <span class="toggle-row__text">
                    <span class="toggle-row__title d-block">Food ordering</span>
                    <span class="toggle-row__desc d-block">Show food items when taking table and bar orders.</span>
                </span>
                <span class="switch">
                    <input asp-for="FoodEnabled" type="checkbox" />
                    <span class="switch__track"></span>
                </span>
            </label>

            <label class="toggle-row">
                <span class="chip-icon chip-icon--sm" data-tone="rose">@Html.Icon("gift")</span>
                <span class="toggle-row__text">
                    <span class="toggle-row__title d-block">Free drinks</span>
                    <span class="toggle-row__desc d-block">Let staff log complimentary drinks on the house.</span>
                </span>
                <span class="switch">
                    <input asp-for="FreeDrinksEnabled" type="checkbox" />
                    <span class="switch__track"></span>
                </span>
            </label>
        </section>

        <div class="row-gap reveal" style="--i:5; justify-content: flex-end;">
            <a asp-action="Index" class="button button--ghost">Cancel</a>
            <button type="submit" class="button button--primary button--lg">@Html.Icon("save") <span>Save settings</span></button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const realtime = document.getElementById('realtimeCheckbox');
            const endTime = document.getElementById('endTimeInput');
            const startTime = document.querySelector('input[name="StartTime"]');

            const toLocalInput = (date) => {
                const d = new Date(date);
                d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                return d.toISOString().slice(0, 16);
            };

            function sync() {
                endTime.disabled = realtime.checked;
                if (!realtime.checked && !endTime.value) endTime.value = toLocalInput(new Date());
            }

            if (!startTime.value) startTime.value = toLocalInput(new Date());
            realtime.addEventListener('change', sync);
            sync();
        })();
    </script>
}
