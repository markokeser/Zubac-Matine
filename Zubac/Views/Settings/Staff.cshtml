@model List<Zubac.Models.StaffViewModel>

@{
    ViewData["Title"] = "Staff";
    var roleCounts = Model.GroupBy(s => s.UserRank).ToDictionary(g => g.Key, g => g.Count());
    var index = 0;
}

@Html.AntiForgeryToken()

<div class="page page--mid">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Settings" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Settings</a>
            <div class="eyebrow reveal">Team</div>
            <h1 class="page-title reveal" style="--i:1">Staff</h1>
            <p class="page-sub reveal" style="--i:2">Manage who can sign in and what they can do. New members set their own password with a one-time link.</p>
        </div>
        <div class="page-head__actions reveal" style="--i:2">
            <a asp-action="AddStaff" class="button button--primary">@Html.Icon("user-plus") Add member</a>
        </div>
    </header>

    @if (!Model.Any())
    {
        <div class="card reveal" style="--i:3">
            <div class="empty">
                <div class="empty__icon">@Html.Icon("users")</div>
                <div class="empty__title">No staff yet</div>
                <p class="empty__text">Add your first team member to get started.</p>
                <a asp-action="AddStaff" class="button button--primary">@Html.Icon("user-plus") Add member</a>
            </div>
        </div>
    }
    else
    {
        <div class="row-gap reveal" style="--i:3; margin-bottom: 16px;">
            <span class="tag" data-tone="muted">@Model.Count members</span>
            @foreach (var rank in new[] { 3, 2, 1, 0 })
            {
                if (roleCounts.TryGetValue(rank, out var count))
                {
                    <span class="tag" data-tone="@UiHelpers.RankTone(rank)">@Html.Icon(UiHelpers.RankIcon(rank)) @count @UiHelpers.RankName(rank)@(count == 1 ? "" : "s")</span>
                }
            }
        </div>

        <div class="card card--flush staff-list reveal" style="--i:4">
            <div class="list-head">
                <span>Member</span>
                <span>Role</span>
                <span style="text-align: right;">Actions</span>
            </div>

            @foreach (var staff in Model.OrderByDescending(s => s.UserRank).ThenBy(s => s.Username))
            {
                var tone = UiHelpers.RankTone(staff.UserRank);
                <div class="list-row reveal" style="--i:@(Math.Min(++index + 4, 16))">
                    <div class="person">
                        <span class="avatar avatar--lg" data-tone="@tone">@UiHelpers.Initials(staff.Username)</span>
                        <div style="min-width: 0;">
                            <div class="person__name">@staff.Username</div>
                            <div class="person__sub">ID @staff.Id</div>
                        </div>
                    </div>
                    <div>
                        <span class="tag" data-tone="@tone">@Html.Icon(UiHelpers.RankIcon(staff.UserRank)) @UiHelpers.RankName(staff.UserRank)</span>
                    </div>
                    <div class="cell-actions c-actions">
                        <button type="button" class="button button--sm button--outline-gold" data-generate-link="@staff.Id" data-username="@staff.Username">
                            @Html.Icon("key") <span>Password link</span>
                        </button>
                        <button type="button" class="button button--sm button--icon button--ghost"
                                data-edit-staff
                                data-id="@staff.Id"
                                data-username="@staff.Username"
                                data-rank="@staff.UserRank"
                                aria-label="Edit @staff.Username" title="Edit">
                            @Html.Icon("pencil")
                        </button>
                        <form asp-action="DeleteStaff" asp-route-id="@staff.Id" method="post" class="d-inline"
                              data-confirm="@staff.Username will lose access immediately. This can't be undone."
                              data-confirm-title="Remove @staff.Username?"
                              data-confirm-ok="Remove member"
                              data-confirm-tone="danger">
                            <button type="submit" class="button button--sm button--icon button--danger-ghost" aria-label="Remove @staff.Username" title="Remove">
                                @Html.Icon("trash")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Generated link -->
<div class="modal fade" id="linkModal" tabindex="-1" aria-labelledby="linkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">
                    <span class="chip-icon">@Html.Icon("link")</span>
                    <div>
                        <div id="linkModalLabel">Password link ready</div>
                        <div class="modal-sub">Send this to <strong data-link-user></strong>. It works once and expires in 1 hour.</div>
                    </div>
                </div>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">@Html.Icon("x")</button>
            </div>
            <div class="modal-body">
                <div class="input-wrap input-wrap--action">
                    @Html.Icon("link")
                    <input type="text" class="input" id="generatedLink" readonly aria-label="Password link" />
                    <button type="button" class="input-wrap__action" id="copyLinkBtn" aria-label="Copy link" title="Copy">@Html.Icon("copy")</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="button button--ghost" data-bs-dismiss="modal">Done</button>
                <button type="button" class="button button--primary" id="copyLinkBtn2">@Html.Icon("copy") Copy link</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit member -->
<div class="modal fade" id="updateStaffModal" tabindex="-1" aria-labelledby="updateStaffLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="updateStaffForm" method="post" asp-action="UpdateStaff" data-loading>
                <div class="modal-header">
                    <div class="modal-title">
                        <span class="chip-icon">@Html.Icon("pencil")</span>
                        <div>
                            <div id="updateStaffLabel">Edit member</div>
                            <div class="modal-sub">Change the username or role.</div>
                        </div>
                    </div>
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">@Html.Icon("x")</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="modalStaffId" />

                    <div class="field">
                        <label class="label" for="modalStaffUsername">Username</label>
                        <div class="input-wrap">
                            @Html.Icon("user")
                            <input type="text" name="Username" id="modalStaffUsername" class="input" required autocomplete="off" />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="modalStaffUserRank">Role</label>
                        <select name="UserRank" id="modalStaffUserRank" class="select" required>
                            <option value="3">Admin</option>
                            <option value="2">Manager</option>
                            <option value="1">Waiter</option>
                            <option value="0">Bartender</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="button button--ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="button button--primary">@Html.Icon("save") <span>Save changes</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const linkModalEl = document.getElementById('linkModal');
            const linkInput = document.getElementById('generatedLink');

            document.querySelectorAll('[data-generate-link]').forEach((btn) => {
                btn.addEventListener('click', async () => {
                    Zubac.setLoading(btn);
                    try {
                        const res = await fetch(`/Settings/GeneratePasswordLink/${btn.dataset.generateLink}`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        });
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        const data = await res.json();

                        if (data.success) {
                            linkInput.value = data.link;
                            linkModalEl.querySelector('[data-link-user]').textContent = btn.dataset.username;
                            bootstrap.Modal.getOrCreateInstance(linkModalEl).show();
                        } else {
                            Zubac.toast(data.message || 'Could not generate the link.', data.message && data.message.startsWith('Demo') ? 'warning' : 'error');
                        }
                    } catch (err) {
                        Zubac.toast('Network error — please try again.', 'error');
                    } finally {
                        Zubac.clearLoading(btn);
                    }
                });
            });

            async function copyLink() {
                if (!linkInput.value) return;
                try {
                    await navigator.clipboard.writeText(linkInput.value);
                    Zubac.toast('Link copied to clipboard');
                } catch (err) {
                    linkInput.select();
                    Zubac.toast('Press Ctrl+C to copy the selected link', 'info');
                }
            }

            document.getElementById('copyLinkBtn').addEventListener('click', copyLink);
            document.getElementById('copyLinkBtn2').addEventListener('click', copyLink);
            linkModalEl.addEventListener('shown.bs.modal', () => linkInput.select());

            const editModalEl = document.getElementById('updateStaffModal');
            document.querySelectorAll('[data-edit-staff]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    document.getElementById('modalStaffId').value = btn.dataset.id;
                    document.getElementById('modalStaffUsername').value = btn.dataset.username;
                    document.getElementById('modalStaffUserRank').value = btn.dataset.rank;
                    bootstrap.Modal.getOrCreateInstance(editModalEl).show();
                });
            });
            editModalEl.addEventListener('shown.bs.modal', () => document.getElementById('modalStaffUsername').focus());
        })();
    </script>
}
