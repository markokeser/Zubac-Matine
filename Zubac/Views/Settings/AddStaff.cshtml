@model Zubac.Models.AddStaffViewModel

@{
    ViewData["Title"] = "Add staff member";
    var selectedRank = ViewContext.HttpContext.Request.Method == "POST" ? Model.UserRank : -1;

    var roles = new[]
    {
        new { Rank = 1, Desc = "Takes table orders and closes their own tables." },
        new { Rank = 0, Desc = "Rings up bar orders and complimentary drinks." },
        new { Rank = 2, Desc = "Everything in service, plus the AI sommelier." },
        new { Rank = 3, Desc = "Full access: statistics, staff, menu and settings." },
    };
}

<div class="page page--narrow">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Settings" asp-action="Staff" class="back-link">@Html.Icon("chevron-left") Staff</a>
            <div class="eyebrow reveal">Team</div>
            <h1 class="page-title reveal" style="--i:1">Add a team member</h1>
            <p class="page-sub reveal" style="--i:2">Create the account, then share a password link so they can choose their own password.</p>
        </div>
    </header>

    <form asp-action="AddStaff" method="post" class="card reveal" style="--i:3" data-loading>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="Username" class="label">Username</label>
            <div class="input-wrap">
                @Html.Icon("user")
                <input asp-for="Username" class="input" placeholder="e.g. ana.k" autocomplete="off" autocapitalize="none" spellcheck="false" autofocus />
            </div>
            <span asp-validation-for="Username"></span>
            <span class="hint">This is what they'll type to sign in.</span>
        </div>

        <div class="field">
            <span class="label" id="roleLabel">Role</span>
            <div class="role-grid" role="radiogroup" aria-labelledby="roleLabel">
                @foreach (var role in roles)
                {
                    <label class="role-card">
                        <input type="radio" name="UserRank" value="@role.Rank" required @(selectedRank == role.Rank ? "checked" : "") />
                        <span class="role-card__body">
                            <span class="chip-icon" data-tone="@UiHelpers.RankTone(role.Rank)">@Html.Icon(UiHelpers.RankIcon(role.Rank))</span>
                            <span>
                                <span class="role-card__title d-block">@UiHelpers.RankName(role.Rank)</span>
                                <span class="role-card__desc d-block">@role.Desc</span>
                            </span>
                            <span class="role-card__check">@Html.Icon("check")</span>
                        </span>
                    </label>
                }
            </div>
            <span asp-validation-for="UserRank"></span>
        </div>

        <div class="notice notice--gold" style="margin: 6px 0 22px;">
            @Html.Icon("key")
            <span>After saving, use <strong>Password link</strong> on the staff list to send them a one-time link for setting their password.</span>
        </div>

        <div class="row-gap" style="justify-content: flex-end;">
            <a asp-action="Staff" class="button button--ghost">Cancel</a>
            <button type="submit" class="button button--primary button--lg">@Html.Icon("user-plus") <span>Add member</span></button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
