@model Zubac.Models.SetPasswordViewModel
@{
    ViewData["Title"] = "Set your password";
    ViewData["HideChrome"] = true;
}

<div class="auth">
    <aside class="auth__showcase">
        <div class="brand">
            <span class="brand__mark">Z</span>
            <span class="brand__text">
                <span class="brand__name">Zubac</span>
                <span class="brand__sub">Restaurant OS</span>
            </span>
        </div>

        <div>
            <div class="eyebrow reveal">Welcome to the team</div>
            <h1 class="auth__headline reveal" style="--i:1">One last step, <em>@Model.Username.</em></h1>
            <p class="auth__lead reveal" style="--i:2">Choose a password for your staff account. You'll use it every time you start a shift.</p>

            <div class="auth__features">
                <div class="auth__feature reveal" style="--i:3">
                    <span class="chip-icon">@Html.Icon("shield")</span>
                    <span>Passwords are stored hashed — nobody can read yours</span>
                </div>
                <div class="auth__feature reveal" style="--i:4">
                    <span class="chip-icon" data-tone="info">@Html.Icon("key")</span>
                    <span>This link works only once and expires after an hour</span>
                </div>
            </div>
        </div>

        <p class="auth__foot">© @DateTime.Now.Year Zubac</p>
    </aside>

    <section class="auth__panel">
        <div class="auth-card reveal">
            <div class="brand auth-card__brand">
                <span class="brand__mark">Z</span>
                <span class="brand__text">
                    <span class="brand__name">Zubac</span>
                    <span class="brand__sub">Restaurant OS</span>
                </span>
            </div>

            <h2 class="auth-card__title">Set your password</h2>
            <p class="auth-card__sub">Signing in as <strong class="gold">@Model.Username</strong></p>

            <form asp-action="SetPassword" method="post" id="passwordForm" class="auth-card__form" data-loading>
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="StaffId" />
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Username" />
                <input type="text" value="@Model.Username" autocomplete="username" hidden readonly aria-hidden="true" />

                <div class="field">
                    <label asp-for="NewPassword" class="label">New password</label>
                    <div class="input-wrap input-wrap--action">
                        @Html.Icon("lock")
                        <input asp-for="NewPassword" class="input" placeholder="Choose a strong password" autocomplete="new-password" autofocus />
                        <button type="button" class="input-wrap__action" data-toggle-password aria-label="Show password">@Html.Icon("eye")</button>
                    </div>
                    <div class="strength" data-strength aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                    <span class="hint" data-strength-label>Use a mix of letters, numbers and symbols.</span>
                    <span asp-validation-for="NewPassword"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword" class="label">Confirm password</label>
                    <div class="input-wrap input-wrap--action">
                        @Html.Icon("check-circle")
                        <input asp-for="ConfirmPassword" class="input" placeholder="Type it again" autocomplete="new-password" />
                        <button type="button" class="input-wrap__action" data-toggle-password aria-label="Show password">@Html.Icon("eye")</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="button button--primary button--lg button--block" style="margin-top: 8px;">
                    <span>Save password</span>
                    @Html.Icon("arrow-right")
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const input = document.querySelector('input[name="NewPassword"]');
            const meter = document.querySelector('[data-strength]');
            const label = document.querySelector('[data-strength-label]');
            const words = ['Use a mix of letters, numbers and symbols.', 'Weak — add more characters.', 'Okay — could be stronger.', 'Good password.', 'Strong password.'];

            input.addEventListener('input', () => {
                const v = input.value;
                let score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                if (/\d/.test(v) && /[^A-Za-z0-9]/.test(v)) score++;
                if (v.length > 0 && score === 0) score = 1;
                meter.dataset.level = v.length ? score : 0;
                label.textContent = words[v.length ? score : 0];
            });
        })();
    </script>
}
