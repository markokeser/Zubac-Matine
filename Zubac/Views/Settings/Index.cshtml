@{
    ViewData["Title"] = "Settings";
    var restaurantName = User.FindFirst("RestaurantName")?.Value;

    var sections = new[]
    {
        new { Action = "Staff", Icon = "users", Tone = "info", Title = "Staff", Desc = "Team members, roles and password links" },
        new { Action = "RestaurantSettings", Icon = "sliders", Tone = "", Title = "Restaurant", Desc = "Service day, food ordering and free drinks" },
        new { Action = "DrinksSettings", Icon = "wine", Tone = "violet", Title = "Drinks menu", Desc = "Prices, availability and AI sommelier picks" },
        new { Action = "FoodSettings", Icon = "utensils", Tone = "amber", Title = "Food menu", Desc = "Dishes, prices and pairing suggestions" },
        new { Action = "AiMenuBuilder", Icon = "sparkles", Tone = "rose", Title = "AI menu builder", Desc = "Snap a photo of a menu and import it in seconds" },
    };
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Home" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Dashboard</a>
            <div class="eyebrow reveal">@(string.IsNullOrWhiteSpace(restaurantName) ? "Administration" : restaurantName)</div>
            <h1 class="page-title reveal" style="--i:1">Settings</h1>
            <p class="page-sub reveal" style="--i:2">Configure your team, your menu and how service runs.</p>
        </div>
    </header>

    <div class="tiles">
        @for (var i = 0; i < sections.Length; i++)
        {
            var s = sections[i];
            <a asp-controller="Settings" asp-action="@s.Action" class="tile @(s.Action == "AiMenuBuilder" ? "tile--feature" : "") reveal" style="--i:@(i + 3)">
                <div class="tile__top">
                    <span class="chip-icon chip-icon--lg" data-tone="@s.Tone">@Html.Icon(s.Icon)</span>
                    <span class="tile__arrow">@Html.Icon("arrow-right")</span>
                </div>
                <div class="tile__body">
                    <div class="tile__title">@s.Title</div>
                    <div class="tile__desc">@s.Desc</div>
                </div>
            </a>
        }
    </div>
</div>
