@model List<Zubac.Models.ArticleViewModel>

@{
    ViewData["Title"] = "Food menu";
    ViewData["IsFood"] = true;
}

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <a asp-controller="Settings" asp-action="Index" class="back-link">@Html.Icon("chevron-left") Settings</a>
            <div class="eyebrow reveal">Menu</div>
            <h1 class="page-title reveal" style="--i:1">Food</h1>
            <p class="page-sub reveal" style="--i:2">Manage dishes and pick which ones guests can pair with a drink in the AI Sommelier.</p>
        </div>
        <div class="page-head__actions reveal" style="--i:2">
            <a asp-action="AiMenuBuilder" class="button button--outline-gold">@Html.Icon("sparkles") Import with AI</a>
            <button type="button" class="button button--primary" data-bs-toggle="modal" data-bs-target="#addItemModal">@Html.Icon("plus") Add dish</button>
        </div>
    </header>

    <partial name="_MenuManager" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <script>Zubac.menuManager(document.querySelector('[data-menu-manager]'));</script>
}
